# --- model ---
LLM_PROVIDER=ollama            # ollama | fake (fake = no model, for UI work/tests)
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=qwen2.5-coder:7b    # try qwen2.5:7b-instruct too (better at plain Q&A + Kannada/Hindi)
NUM_CTX=6144                   # keep modest on a 6 GB GPU shared with the 3D frontend
MAX_NEW_TOKENS=450
TEMPERATURE=0.2
KEEP_ALIVE=30m

# --- retrieval ---
USE_EMBEDDINGS=false           # true = also use EMBED_MODEL (ollama pull nomic-embed-text)
EMBED_MODEL=nomic-embed-text

# --- data ---
USE_MOCK=true                  # false = call your real backend
BACKEND_BASE_URL=http://localhost:8000

# --- server ---
CORS_ORIGINS=http://localhost:3000
ADMIN_TOKEN=
APP_NAME=Jaladrishti
